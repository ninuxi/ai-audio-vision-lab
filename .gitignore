*.pkl
# Joblib serialized models
*.joblib
# ONNX models
*.onnx

# Model directories
models/
weights/
checkpoints/
saved_models/
model_cache/

# ============================================================================
# PROPRIETARY CODE AND ALGORITHMS - NEVER COMMIT
# ============================================================================
# Core proprietary algorithms
src/core/
# Proprietary implementations
src/proprietary/
# Private development files
private/
# Internal-only code
internal/
# Commercial licensing code
commercial/

# Training and research code
# Full training implementations
training_scripts/
# Research notebooks and experiments
research/
# Experimental code and results
experiments/

# Configuration files with secrets
# Private configuration files
*_private.py
# Secret configuration files
*_secret.py
# Proprietary implementation files
*_proprietary.py
# Production configurations
config_production.py
# Commercial configurations
config_commercial.py

